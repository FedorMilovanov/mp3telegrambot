# Generated pages archive runtime exports (created automatically by bot)
/data/generated_pages/*.sqlite
/data/generated_pages/*.jsonl
/data/generated_pages/*.md
/data/generated_pages/by_date/
# Runtime per-video segment exports (regenerated by the bot at runtime)
/data/generated_pages/segments/

# Runtime log file (+ rotated backups: bot.log.1, bot.log.2, ...)
bot.log
bot.log.*

