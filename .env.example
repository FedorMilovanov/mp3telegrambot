BOT_TOKEN=ваш_токен_бота
WHITELIST_IDS=123456789,987654321
# ADMIN_IDS — по умолчанию совпадает с WHITELIST_IDS; задайте отдельно если нужно
# ADMIN_IDS=123456789

# Автостарт локального Bot API сервера самим ботом (round 33b).
# Укажите api_id/api_hash с my.telegram.org — если сервер не запущен,
# бот поднимет его сам (detached, переживает рестарты бота).
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# Путь к exe, если нестандартный:
# LOCAL_BOT_API_EXE=C:\Program Files\TelegramBotAPI\telegram-bot-api.exe
# Отключить автостарт: LOCAL_BOT_API_AUTOSTART=0

# Локальный Telegram Bot API сервер (опционально).
# Если задан — бот шлёт запросы через него: лимит отправки растёт с 50 МБ до 2000 МБ.
# Перед переключением один раз вызови https://api.telegram.org/bot<TOKEN>/logOut
# LOCAL_BOT_API_URL=http://127.0.0.1:8081

# Лимит размера отправляемых файлов в МБ (опционально).
# По умолчанию: 50 (облачный API) или 2000 (если задан LOCAL_BOT_API_URL).
# MAX_FILE_SIZE_MB=2000

# Рабочая папка локального Bot API сервера (опционально).
# Если задана — бот раз в час удаляет из неё медиа-копии старше суток
# (сервер копирует каждый file://-upload к себе и сам НЕ чистит).
# LOCAL_BOT_API_DATA_DIR=C:\ProgramData\TelegramBotAPI\data


# ── Работа без TUN/VPN: proxy-настройки Telegram ──────────────────
# 1) Если НЕ используете локальный Bot API сервер (LOCAL_BOT_API_URL пустой),
# Python-бот может ходить к api.telegram.org через proxy:
# TELEGRAM_PROXY_URL=socks5://user:pass@127.0.0.1:1080
# Для SOCKS установлен extra python-telegram-bot[socks].
# Важно: socks5h:// резолвит DNS через proxy; это предпочтительно при блокировках DNS.
# TELEGRAM_PROXY_URL=socks5h://127.0.0.1:10808
# Если не установлен socksio, бот попробует HTTP fallback на mixed-port v2rayN
# (обычно тот же 10808). 0 = не fallback'аться, а честно падать.
# TELEGRAM_PROXY_HTTP_FALLBACK=1
# yt-dlp — отдельный процесс; ему тоже нужен proxy без TUN. По умолчанию он
# переиспользует YTDLP_PROXY_URL/TELEGRAM_PROXY_URL/LOCAL_BOT_API_PROXY_URL и
# для v2rayN mixed-port превращает SOCKS в HTTP. Можно задать явно:
# YTDLP_PROXY_URL=http://127.0.0.1:10808
# YTDLP_INFO_TIMEOUT=180
# Gemini API (google-genai) использует httpx, который берёт прокси из HTTPS_PROXY.
# Если HTTPS_PROXY не задан, бот автоматически подхватит TELEGRAM_PROXY_URL
# и конвертирует SOCKS→HTTP для v2rayN mixed port. Явно задать отдельный прокси:
# GEMINI_PROXY_URL=http://127.0.0.1:10808
#
# 2) Если используете LOCAL_BOT_API_URL=http://127.0.0.1:8081, Python ходит
# только в localhost. ВАЖНО: официальный telegram-bot-api.exe не принимает
# SOCKS/MTProto TDLib proxy-флаги. Для no-TUN используйте облачный Bot API +
# TELEGRAM_PROXY_URL или включайте TUN/VPN для локального сервера.
# Поддержанный CLI proxy у telegram-bot-api — только HTTP --proxy=<url>
# (в основном для webhook-запросов; SOCKS сюда не передавать):
# LOCAL_BOT_API_PROXY_URL=http://user:pass@127.0.0.1:8080
# Старые LOCAL_BOT_API_TDLIB_PROXY_* оставлены только для диагностики/совместимости
# и НЕ передаются как --proxy-server/--tdlib-proxy-type официальному бинарю.
# Если local Bot API порт открыт, но /getMe не работает, бот по умолчанию
# fallback'нется на облачный Bot API через TELEGRAM_PROXY_URL или SOCKS из
# LOCAL_BOT_API_PROXY_URL (с лимитами облачного Telegram). 0 = не fallback'аться.
# LOCAL_BOT_API_CLOUD_FALLBACK=1
# LOCAL_BOT_API_TDLIB_PROXY_TYPE=
# LOCAL_BOT_API_PROXY_SERVER=
# LOCAL_BOT_API_PROXY_PORT=
# LOCAL_BOT_API_PROXY_LOGIN=
# LOCAL_BOT_API_PROXY_PASSWORD=
# LOCAL_BOT_API_PROXY_SECRET=              # для mtproto

# ── LiveDub Pro-микс (режимы ENG) ─────────────────────────────────
# Громкость оригинала в миксе (0..10). Раньше было 0.3 — слишком тихо.
# LIVEDUB_ORIG_VOLUME=0.45
# Громкость перевода (0..10).
# LIVEDUB_TRANS_VOLUME=1.3
# Задержка перевода относительно оригинала, мс (0..5000):
# сначала слышна английская фраза, затем догоняет перевод.
# LIVEDUB_DELAY_MS=600
# Запас в конце сверх задержки, мс: защищает Shorts от обрыва последней
# русской фразы после нашего сдвига. Итоговый хвост = DELAY + MARGIN.
# LIVEDUB_TAIL_MARGIN_MS=1000
# Для коротких роликов бот ещё и замораживает последний кадр на этот хвост,
# чтобы Telegram не закончил видео раньше аудио. 0 = не замораживать кадр.
# LIVEDUB_TAIL_FREEZE_MAX_SEC=180

# Дословные конспекты: перед Synopsis бот пытается скачать YouTube/auto captions
# и отдаёт Gemini timed transcript как скелет речи. Это резко снижает риск
# «обзорной статьи» вместо структурированной стенограммы. 0 = выключить.
# SYNOPSIS_YT_TRANSCRIPT=1
# SYNOPSIS_YT_TRANSCRIPT_MAX_CHARS=120000
# SYNOPSIS_YT_TRANSCRIPT_LANGS=en.*,en
# Для длинных видео отбрасываем частичные captions, если они покрывают меньше 70%.
# SYNOPSIS_YT_TRANSCRIPT_MIN_COVERAGE=0.70
# Synopsis по умолчанию использует чистый verbatim-prompt без Study/Reflection/source-card
# шума: это ближе к старому режиму, где Gemini делала структурированную стенограмму.
# 0 = вернуться к старому перегруженному SYNOPSIS_PROMPT_V2.
# SYNOPSIS_VERBATIM_PROMPT=1
# Synopsis по умолчанию НЕ использует Gemini response_schema: старый schema-free
# режим лучше держит дословную стенограмму. Включать только если важнее JSON-форма.
# SYNOPSIS_STRUCTURED=0

# Аварийный fallback на обычные голоса (tts). По умолчанию ВЫКЛЮЧЕН:
# режим ENG должен выдавать только «Живые голоса» или честную ошибку.
# Включайте только если осознанно согласны на НЕживой перевод.
# LIVEDUB_TTS_FALLBACK=0

# ── «Живые голоса»: OAuth-токен Яндекса (ОБЯЗАТЕЛЕН с мая 2025!) ──
# Яндекс требует авторизацию для живых голосов (status=7 SESSION_REQUIRED).
# Без токена живые голоса отдаются ТОЛЬКО если кто-то уже переводил этот
# ролик (серверный кэш) — поэтому часть видео «работала», а часть нет.
# Как получить токен (1 раз, живёт ~1 год):
#   1. Открой в браузере: https://rust-server-531j.onrender.com/v1/auth/handle
#      (это официальный логин-сервер расширения VOT; он редиректит на
#      oauth.yandex.ru с client_id приложения VOT)
#   2. Войди в аккаунт Яндекса и разреши доступ
#   3. После редиректа СРАЗУ скопируй из адресной строки значение
#      access_token=... (до символа &)
#   4. Впиши сюда и перезапусти бота:
# VOT_API_TOKEN=y0_AgA...твой_токен
# Альтернативное имя тоже поддерживается:
# YANDEX_OAUTH_TOKEN=y0_AgA...твой_токен

# ENG Quick QA mode (/mode): быстрый DUB + лёгкая проверка коротких роликов.
# Режим выбирается в боте кнопкой «⚡🔍 ENG Quick QA»; env только задаёт лимиты.
# LIVEDUB_QUICK_QA_MAX_DURATION=120
# LIVEDUB_QUICK_QA_MODEL=gemini-3.1-flash-lite
# LIVEDUB_QUICK_QA_THINKING=minimal

# Лёгкая Gemini-модель для дешёвых текстовых задач: title/описания/тезисы.
# Не влияет на основной глубокий анализ (GEMINI_MODEL).
# Хороший бесплатный/дешёвый кандидат на 2026: gemini-3.1-flash-lite.
# GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite
# Fallback если 3.1 недоступна/квота: preview, 2.5-lite, затем основная GEMINI_MODEL (если разрешено).
# GEMINI_LIGHT_FALLBACK_MODELS=gemini-3.1-flash-lite-preview,gemini-2.5-flash-lite
# GEMINI_LIGHT_ALLOW_MAIN_FALLBACK=1
# ENG Quick: после DUB отправлять отдельную карточку с TG/YT description и компактными тезисами.
# Использует Yandex SRT, если удалось получить, и GEMINI_LIGHT_MODEL; fallback без ИИ.
# LIVEDUB_INFO_CARD=1

# Перевод названия в caption для ENG Dub.
# По умолчанию 1: ENG Full использует уже готовые real_title/real_author из анализа,
# ENG Quick переводит title через GEMINI_LIGHT_MODEL; если выключить — только YouTube metadata.
# LIVEDUB_TITLE_TRANSLATE=1

# Авто-правка major-ошибок QA: RU-дубляж в проблемном окне полностью вырезается,
# оригинал поднимается. Это защищает от роковых ошибок машинного перевода.
# LIVEDUB_AUTOFIX_RU_VOLUME=0.0
# LIVEDUB_AUTOFIX_EN_BOOST=2.2

# AI-шумодав RNNoise для EN-оригинала (гул зала, шум проектора).
# Скачайте модель: https://github.com/GregorR/rnnoise-models
# (рекомендуем cb.rnnn) и укажите путь. Пусто = выключено.
# LIVEDUB_RNNOISE_MODEL=C:\Bots\models\cb.rnnn

# Опциональные ключи (могут быть пустыми)
TELEGRAPH_TOKEN=
GEMINI_API_KEY=AIza...
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# VK API токен для поиска видео во ВКонтакте (fallback-источник, когда
# YouTube-версия недоступна). Без токена VK-поиск отключён.
# VK_API_TOKEN=

# Настройки Whisper
WHISPER_MODEL=small

# Принудительный CPU-энкодер видео (1 = не пробовать NVENC).
# NVENC — отдельный ASIC-блок GPU, не CUDA: обычно стабилен даже когда
# CUDA глючит (Whisper на CPU). По умолчанию NVENC автодетектится.
# VIDEO_FORCE_CPU=1

# Пресет CPU-энкодера для Shorts/Clips (по умолчанию veryfast).
# На мощном CPU (Ryzen 7+) можно поставить medium: +20-30% компрессии
# при том же качестве, рендер ~2x дольше. КАЧЕСТВО: medium > veryfast.
# VIDEO_CPU_PRESET=medium

# Глобально форсировать CPU для ВСЕХ Whisper-вызовов (shorts + eng_subtitles).
# Игнорирует WHISPER_DEVICE. Рекомендуется 1 при глючной GPU.
WHISPER_FORCE_CPU=1

# WHISPER_DEVICE не используется, если WHISPER_FORCE_CPU=1.
WHISPER_DEVICE=cpu

# Безопасный режим GPU для Whisper: при WHISPER_DEVICE=cuda использовать
# int8 вместо float16 — меньше нагрев/VRAM на глючных GPU.
# WHISPER_GPU_SAFE_MODE=1

# Модель для английских субтитров (eng_subtitles). На CPU medium ~3-4x быстрее large-v3.
# Если не указано — используется WHISPER_MODEL или large-v3.
# WHISPER_ENG_SUBTITLES_MODEL=medium

# Настройки Gemini
GEMINI_MODEL=gemini-3.5-flash
AUDIO_ANALYSIS_MODE=deep

# Нормализация громкости MP3 — lossless через mp3gain (меняет только
# global_gain в заголовках фреймов, БЕЗ перекодирования, обратимо).
# Установите mp3gain: winget install GlenSawyer.MP3Gain (Windows).
# Без mp3gain файл не трогается. 0 = отключить полностью.
# MP3_LOUDNORM=1

# SponsorBlock: вырезать сегменты из MP3 (crowdsource-база sponsor.ajay.app).
# ВНИМАНИЕ: вырезка сдвигает таймлайн mp3 относительно YouTube — ⏱-ссылки
# в caption после выреза будут опережать видео. Конспект для mp3 точен.
# Категории: sponsor,selfpromo,interaction,intro,outro,preview,filler
# SPONSORBLOCK_REMOVE=sponsor,selfpromo

# Многопоточная загрузка фрагментов yt-dlp (1..16, по умолчанию 4).
# YTDLP_FRAGMENTS=4

# Источник cookies для yt-dlp, если нет cookies.txt.
# Пример: firefox или firefox:C:\Users\Fedor\AppData\Roaming\Mozilla\Firefox\Profiles\xxxx.default-release
# Если yt-dlp.conf просит --cookies-from-browser, но профиль не найден, бот пропустит конфиг,
# чтобы скачивание не падало целиком.
# YTDLP_COOKIES_FROM_BROWSER=firefox

# Прожиг русских субтитров в кадр для коротких роликов ENG (по умолчанию 1).
# Telegram-плеер НЕ показывает встроенные mov_text-дорожки — прожиг
# гарантирует видимость. 0 = вернуть мягкие субтитры (mov_text).
# LIVEDUB_HARDSUB=1

# Лимиты
MAX_VIDEO_DURATION_SEC=10800
PLAYLIST_DELAY_SEC=1.0

# Ремонт таймкодов
AUDIO_TIMESTAMP_REPAIR=1
AUDIO_TIMESTAMP_REPAIR_TIMEOUT=240

# Режим конспекта
COMBINE_STUDY_REFLECTION=0

# Системные
DISABLE_HEALTH_CHECK=1

# Отключение логов симлинков (добавлено в код, но можно продублировать тут)
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ── Продвинутые настройки (все опциональны, дефолты разумные) ─────
# Кэш анализа видео: срок жизни записей (дней) и версия-отпечаток.
# Смена CACHE_VERSION инвалидирует весь старый кэш.
# CACHE_TTL_DAYS=45
# CACHE_VERSION=2026-03-22-v5

# Аудит качества страниц/контента: off | warn | strict.
# PAGE_AUDIT_MODE перекрывает CONTENT_AUDIT_MODE (по умолчанию warn).
# CONTENT_AUDIT_MODE=warn
# PAGE_AUDIT_MODE=warn
# Блокировка публикации при strict-аудите — ТОЛЬКО явный opt-in:
# CONTENT_AUDIT_BLOCK_PUBLICATION=0
# PAGE_AUDIT_BLOCK_PUBLICATION=0
# AUDIT_BLOCK_PUBLICATION=0
# Какие коды аудита считать строгими (пусто = только критичные):
# PAGE_AUDIT_STRICT_CODES=
# CONTENT_AUDIT_STRICT_CODES=

# Авторемонт Telegraph-страниц сразу после публикации (нужен TELEGRAPH_TOKEN).
# TELEGRAPH_AUTO_REPAIR_AFTER_PUBLISH=1

# Retry конспекта при слабом покрытии таймлайна (см. synopsis_time_coverage).
# SYNOPSIS_DENSITY_RETRY=1

# Structured-режимы Gemini (JSON response_schema) для аудио-анализа и
# расширенных страниц. Fallback-режим: strict (по умолчанию) или honest —
# честно помечать деградированный результат вместо строгого отказа.
# AUDIO_ANALYSIS_STRUCTURED=1
# AUDIO_ANALYSIS_FALLBACK_MODE=strict
# AUDIO_STRUCTURED_TIMEOUT=180
# EXPANDED_PAGES_STRUCTURED=1
# EXPANDED_CONTENT_AUDIT_RETRY=1

# Блокировки параллельного рендера одного видео (сек).
# VIDEO_LOCK_TTL_SEC=3600
# VIDEO_LOCK_WAIT_TIMEOUT_SEC=300

# Каталог архива сгенерированных страниц (по умолчанию data/generated_pages).
# GENERATED_PAGES_DIR=

# Пути к шрифтам/wkhtmltopdf для PDF-конспектов (Windows).
# PDF_FONTS_DIR=
# PDF_BODY_FONT=
# PDF_SANS_FONT=
# WKHTMLTOPDF_PATH=
