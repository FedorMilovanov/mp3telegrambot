BOT_TOKEN=ваш_токен_бота
WHITELIST=123456789,987654321
WEBHOOK_URL=https://ваша_ссылка_на_вебхук
WEBHOOK_PORT=8443
SECRET_TOKEN=секретный_токен

# Опциональные ключи (могут быть пустыми)
TELEGRAPH_TOKEN=
GEMINI_API_KEY=AIza...
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

RUTUBE_USERNAME=
RUTUBE_PASSWORD=

# Настройки Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Глобально форсировать CPU для ВСЕХ Whisper-вызовов (shorts + eng_subtitles).
# Игнорирует WHISPER_DEVICE. Рекомендуется 1 при глючной GPU.
WHISPER_FORCE_CPU=1

# WHISPER_DEVICE уже не используется, если WHISPER_FORCE_CPU=1.
WHISPER_DEVICE=cpu

# Модель для английских субтитров (eng_subtitles). На CPU medium ~3-4x быстрее large-v3.
# Если не указано — используется WHISPER_MODEL или large-v3.
# WHISPER_ENG_SUBTITLES_MODEL=medium

# Настройки Gemini
GEMINI_MODEL=gemini-3.5-flash
AUDIO_ANALYSIS_MODE=deep

# Лимиты
MAX_VIDEO_DURATION_SEC=10800
PLAYLIST_DELAY_SEC=1.0

# Ремонт таймкодов
AUDIO_TIMESTAMP_REPAIR=1
AUDIO_TIMESTAMP_REPAIR_TIMEOUT=240

# Режим конспекта
COMBINE_STUDY_REFLECTION=0

# Системные
DISABLE_HEALTH_CHECK=1

# Отключение логов симлинков (добавлено в код, но можно продублировать тут)
HF_HUB_DISABLE_SYMLINKS_WARNING=1
