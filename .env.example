BOT_TOKEN=ваш_токен_бота
WHITELIST=123456789,987654321
WEBHOOK_URL=https://ваша_ссылка_на_вебхук
WEBHOOK_PORT=8443
SECRET_TOKEN=секретный_токен

# Опциональные ключи (могут быть пустыми)
TELEGRAPH_TOKEN=
GEMINI_API_KEY=AIza...
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

RUTUBE_USERNAME=
RUTUBE_PASSWORD=

# Настройки Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Глобально форсировать CPU для ВСЕХ Whisper-вызовов (shorts + eng_subtitles).
# Игнорирует WHISPER_DEVICE. Ставь 1 если GPU глючит или умирает.
WHISPER_FORCE_CPU=1

# Принудительно использовать CPU только для английских субтитров (eng_subtitles).
# Устаревает если WHISPER_FORCE_CPU=1, но сохраняется для тонкой настройки.
WHISPER_ENG_SUBTITLES_FORCE_CPU=1

# Настройки Gemini
GEMINI_MODEL=gemini-3.5-flash
AUDIO_ANALYSIS_MODE=deep

# Лимиты
MAX_VIDEO_DURATION_SEC=10800
PLAYLIST_DELAY_SEC=1.0

# Ремонт таймкодов
AUDIO_TIMESTAMP_REPAIR=1
AUDIO_TIMESTAMP_REPAIR_TIMEOUT=240

# Режим конспекта
COMBINE_STUDY_REFLECTION=0

# Системные
DISABLE_HEALTH_CHECK=1

# Отключение логов симлинков (добавлено в код, но можно продублировать тут)
HF_HUB_DISABLE_SYMLINKS_WARNING=1
