# =============================================
# Дополнительно
# =============================================
# DB_PATH=bot_cache.db

# =============================================
# Runtime / stability tuning
# =============================================
WHITELIST_IDS=
CACHE_VERSION=2026-03-22-v5
CACHE_TTL_DAYS=45
PROMPT_SCHEMA_VERSION=analysis-deep-v7
MAX_VIDEO_DURATION_SEC=10800
PLAYLIST_DELAY_SEC=1.0
VIDEO_LOCK_TTL_SEC=3600
VIDEO_LOCK_WAIT_TIMEOUT_SEC=300
FORCE_EXIT_ON_STOP=0
PORT=10000

# Optional proxy settings
