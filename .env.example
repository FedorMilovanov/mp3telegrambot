BOT_TOKEN=ваш_токен_бота
WHITELIST=123456789,987654321

# Локальный Telegram Bot API сервер (опционально).
# Если задан — бот шлёт запросы через него: лимит отправки растёт с 50 МБ до 2000 МБ.
# Перед переключением один раз вызови https://api.telegram.org/bot<TOKEN>/logOut
# LOCAL_BOT_API_URL=http://127.0.0.1:8081

# Лимит размера отправляемых файлов в МБ (опционально).
# По умолчанию: 50 (облачный API) или 2000 (если задан LOCAL_BOT_API_URL).
# MAX_FILE_SIZE_MB=2000

# ── LiveDub Pro-микс (режимы ENG) ─────────────────────────────────
# Громкость оригинала в миксе (0..10). Раньше было 0.3 — слишком тихо.
# LIVEDUB_ORIG_VOLUME=0.45
# Громкость перевода (0..10).
# LIVEDUB_TRANS_VOLUME=1.3
# Задержка перевода относительно оригинала, мс (0..5000):
# сначала слышна английская фраза, затем догоняет перевод.
# LIVEDUB_DELAY_MS=600
WEBHOOK_URL=https://ваша_ссылка_на_вебхук
WEBHOOK_PORT=8443
SECRET_TOKEN=секретный_токен

# Опциональные ключи (могут быть пустыми)
TELEGRAPH_TOKEN=
GEMINI_API_KEY=AIza...
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

RUTUBE_USERNAME=
RUTUBE_PASSWORD=

# Настройки Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Глобально форсировать CPU для ВСЕХ Whisper-вызовов (shorts + eng_subtitles).
# Игнорирует WHISPER_DEVICE. Рекомендуется 1 при глючной GPU.
WHISPER_FORCE_CPU=1

# WHISPER_DEVICE уже не используется, если WHISPER_FORCE_CPU=1.
WHISPER_DEVICE=cpu

# Модель для английских субтитров (eng_subtitles). На CPU medium ~3-4x быстрее large-v3.
# Если не указано — используется WHISPER_MODEL или large-v3.
# WHISPER_ENG_SUBTITLES_MODEL=medium

# Настройки Gemini
GEMINI_MODEL=gemini-3.5-flash
AUDIO_ANALYSIS_MODE=deep

# Лимиты
MAX_VIDEO_DURATION_SEC=10800
PLAYLIST_DELAY_SEC=1.0

# Ремонт таймкодов
AUDIO_TIMESTAMP_REPAIR=1
AUDIO_TIMESTAMP_REPAIR_TIMEOUT=240

# Режим конспекта
COMBINE_STUDY_REFLECTION=0

# Системные
DISABLE_HEALTH_CHECK=1

# Отключение логов симлинков (добавлено в код, но можно продублировать тут)
HF_HUB_DISABLE_SYMLINKS_WARNING=1
