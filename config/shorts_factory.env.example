# SHORTS FACTORY MAX — quality-first production profile
# Copy only the needed values into the root .env.

# Canonical Gemini Pro route at or above 3.1. Flash/Lite, older Pro models and
# aliases that merely contain the word "pro" fail the required runtime startup.
SHORTS_FACTORY_MODEL=gemini-3.1-pro-preview

# Final editorial acceptance thresholds after all three Gemini passes.
# Values may be raised for a smaller, stricter selection. Lower values are
# ignored: Factory never drops below 88 for Shorts or 85 for long clips.
SHORTS_FACTORY_MIN_SHORT_SCORE=88
SHORTS_FACTORY_MIN_LONG_SCORE=85

# Mandatory exact ASR model for burned Shorts subtitles. Smaller/compressed
# routes, including large-v3-turbo, fail startup instead of downgrading quality.
SHORTS_FACTORY_WHISPER_MODEL=large-v3

# Preflight stops before downloads when either downloads/temp has less space.
# Values above 2.0 are allowed; lower values are floored to 2.0 GB.
SHORTS_FACTORY_MIN_FREE_GB=2.0

# Only implemented translation backend. Future neural providers remain disabled.
SHORTS_FACTORY_TRANSLATION_BACKEND=yandex_live
SHORTS_FACTORY_LIVEDUB=1

# LiveDub normally requires OAuth before a foreign-language Factory job starts.
# Set 0 only to intentionally allow cache-only Yandex attempts without a token;
# this never enables an original-language or in-house neural fallback.
SHORTS_FACTORY_REQUIRE_VOT_TOKEN=1

# Maximum accepted source: 3 hours. Lowering this is a stricter operator limit.
SHORTS_FACTORY_MAX_SOURCE_SEC=10800

# Minimum wait for Yandex LiveDub or original source download: 30 minutes.
# Larger values are allowed; values below 1800 seconds are floored to 1800.
SHORTS_FACTORY_LIVEDUB_TIMEOUT_SEC=1800

# Preserve the semantic start and add a safe Yandex voice envelope in Factory.
# These are quality floors: larger values may be requested, lower values are
# ignored. The final 180/900-second public limits still remain mandatory.
SHORTS_FACTORY_LIVEDUB_PREROLL_SEC=0.25
SHORTS_FACTORY_LIVEDUB_TAIL_EXTRA_SEC=0.15

# The same protection for legacy Shorts, Clips and Montage in ENG modes.
LIVEDUB_DOWNSTREAM_PREROLL_SEC=0.25
LIVEDUB_DOWNSTREAM_TAIL_EXTRA_SEC=0.15

# Fail closed unless ffprobe proves the translated source has video+audio and
# returns an exact duration. Set 0 only for an explicit degraded legacy mode;
# SHORTS FACTORY itself still performs its own mandatory exact source probe.
LIVEDUB_DOWNSTREAM_REQUIRE_PROBE=1

# Shared source is retained for interactive trim buttons, then cleaned.
SHORTS_FACTORY_SOURCE_RETENTION_HOURS=24

# Existing LiveDub mix knobs used by both timing envelopes.
LIVEDUB_DELAY_MS=600
LIVEDUB_TAIL_MARGIN_MS=1000

# Factory requires faster-whisper. CPU is slower but deterministic and safe.
WHISPER_FORCE_CPU=1
WHISPER_DEVICE=cpu
