{
  "schema_version": 1,
  "id": "generic_short_v1",
  "title": "Универсальный дубляж YouTube — живой чистый мастер",
  "speaker": "Определяется из исходного ролика",
  "source_url": "",
  "description": "Clean Expressive Production: риторически точный трёхпроходный Gemini MAX перевод, короткие устойчивые реплики до 5.4 сек., плавная эмоциональная дуга по F0/энергии/темпу оригинала, спокойный и controlled-expressive реальные референсы автора без крика, прямой PowerShell-equivalent NoChew renderer/master и независимый QA; оригинал 18%.",
  "work_root": "C:\\AI-Archive\\MP3Bot-Dub-Studio",
  "actions": {
    "render": {
      "kind": "render",
      "label": "Gemini MAX — живой чистый полный рендер",
      "runner": "python_module",
      "module": "tools.voxcpm2.generic_gemini_runtime",
      "parameters": {
        "Mode": "gemini"
      }
    },
    "render_gemini": {
      "kind": "render",
      "label": "Gemini MAX — живой перевод, выразительный клон и ролик",
      "runner": "python_module",
      "module": "tools.voxcpm2.generic_gemini_runtime",
      "parameters": {
        "Mode": "gemini"
      }
    },
    "render_direct": {
      "kind": "render",
      "label": "Мой готовый SRT — живой прямой рендер без изменений",
      "runner": "python_module",
      "module": "tools.voxcpm2.generic_direct_runtime",
      "parameters": {
        "Mode": "direct"
      }
    },
    "repair_audio": {
      "kind": "utility",
      "label": "Живой чистый аудиоремонт без повторного перевода",
      "runner": "python_module",
      "module": "tools.voxcpm2.generic_clean_audio_repair_runtime",
      "parameters": {}
    },
    "prepare_custom": {
      "kind": "prepare",
      "label": "Подготовить шаблон пользовательского перевода",
      "runner": "python_module",
      "module": "tools.voxcpm2.generic_custom_runtime",
      "parameters": {
        "Mode": "custom",
        "PrepareOnly": true
      }
    },
    "render_custom": {
      "kind": "render",
      "label": "Пользовательский перевод — живой чистый рендер",
      "runner": "python_module",
      "module": "tools.voxcpm2.generic_custom_runtime",
      "parameters": {
        "Mode": "custom"
      }
    }
  },
  "outputs": {
    "manifest": {
      "label": "Production manifest",
      "path": "{work_root}/output/manifest.json",
      "required": true,
      "min_bytes": 128,
      "actions": [
        "render",
        "render_gemini",
        "render_direct",
        "render_custom",
        "repair_audio",
        "prepare_custom"
      ]
    },
    "mixed_video": {
      "label": "Основной mixed MP4",
      "path": "{work_root}/output/final_upload.mp4",
      "required": true,
      "primary": true,
      "media": "av",
      "min_bytes": 102400,
      "actions": [
        "render",
        "render_gemini",
        "render_direct",
        "render_custom",
        "repair_audio"
      ]
    },
    "russian_only_video": {
      "label": "Russian-only MP4",
      "path": "{work_root}/output/russian_only.mp4",
      "required": true,
      "media": "av",
      "min_bytes": 102400,
      "actions": [
        "render",
        "render_gemini",
        "render_direct",
        "render_custom",
        "repair_audio"
      ]
    },
    "russian_srt": {
      "label": "Russian SRT",
      "path": "{work_root}/output/russian_subtitles.srt",
      "required": true,
      "min_bytes": 32,
      "actions": [
        "render",
        "render_gemini",
        "render_direct",
        "render_custom",
        "repair_audio"
      ]
    },
    "translation": {
      "label": "Russian translation",
      "path": "{work_root}/output/russian_translation.txt",
      "required": true,
      "min_bytes": 32,
      "actions": [
        "render",
        "render_gemini",
        "render_direct",
        "render_custom",
        "repair_audio"
      ]
    },
    "translation_qa": {
      "label": "Translation QA report",
      "path": "{work_root}/output/translation_qa.txt",
      "required": true,
      "min_bytes": 16,
      "actions": [
        "render",
        "render_gemini",
        "render_direct",
        "render_custom",
        "repair_audio"
      ]
    },
    "translation_template": {
      "label": "Custom translation template",
      "path": "{work_root}/output/translation_template.txt",
      "required": true,
      "min_bytes": 32,
      "actions": [
        "prepare_custom"
      ]
    }
  }
}
