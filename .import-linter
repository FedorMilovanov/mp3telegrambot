[importlinter]
root_packages =
    core
    services
    converters
    pipelines
    handlers
# Imports used only for annotations do not create runtime coupling.
exclude_type_checking_imports = True

[importlinter:contract:production-layers]
name = Production dependencies flow toward core
type = layers
layers =
    handlers
    pipelines
    services
    converters
    core
# Burn-down complete: there is no ignore_imports escape hatch. Every reverse
# edge fails this contract, and stale ignores are errors if ever reintroduced.
unmatched_ignore_imports_alerting = error
broken_contract_guidance =
    Keep the direction handlers -> pipelines -> services -> converters -> core.
    Do not reintroduce ignore_imports. Move orchestration upward or reusable
    policy downward so the production graph remains layered without exceptions.
